[Unit]
Description=BarbieNode local Meshtastic interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/barbienode-ping/venv/bin/python /opt/barbienode-web/web_server.py
EnvironmentFile=-/etc/barbienode/barbienode.env
Environment=WEB_ROOT=/opt/barbienode-web
Environment=PORT=8082
Environment=LINK_QUALITY_PATH=/var/lib/barbienode-link-quality/events.jsonl
Environment=DELIVERY_STATUS_PATH=/var/lib/barbienode-link-quality/deliveries.jsonl
Environment=DEVICE_URL=http://192.168.1.31
Environment=NODE_CACHE_PATH=/var/lib/barbienode-web/node-cache.json
StateDirectory=barbienode-web
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
